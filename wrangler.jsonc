{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exedra-record",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exedra-record",
      "database_id": "aa62db47-a17f-4e60-b481-d4c970c93404",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "7b33c59c1366ca82db48b21179a06bd1",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
